    {
      "@type": "FAQPage",
      "@id": "https://ridetoalps.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What happens if my flight is delayed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nothing to worry about. We track your flight and wait for the actual landing time rather than the scheduled one. There is no extra waiting fee."
          }
        },
        {
          "@type": "Question",
          "name": "How does payment work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You pay a €30 or $35 deposit to confirm the booking. The balance is paid only after the ride is completed — cash or card with the driver, or online."
          }
        },
        {
          "@type": "Question",
          "name": "Can I cancel or move my transfer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Cancel at least 48 hours before the booked date and the deposit is refunded in full. Later than that, the deposit is non-refundable."
          }
        },
        {
          "@type": "Question",
          "name": "How many passengers and how much luggage fit in one car?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Mercedes V-Class comfortably takes 5 to 7 passengers. Larger groups travel in several cars. Per passenger we plan for one cabin bag and one standard suitcase, plus sports luggage — one ski or board bag per two people. Many of our cars carry roof boxes for long bags; tell us in advance if your luggage is unusual so we can assign the right vehicle."
          }
        },
        {
          "@type": "Question",
          "name": "Where does the driver meet us at the airport?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In the arrivals hall, holding a sign with your name. You are in touch with us on WhatsApp or by phone from the moment your plane lands."
          }
        },
        {
          "@type": "Question",
          "name": "Which languages do the drivers speak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "English and German fluently. Ukrainian and Russian are available on request."
          }
        },
        {
          "@type": "Question",
          "name": "Can we stop on the way for fuel, a coffee or a photo?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, short stops along the route are included — just tell the driver. Additional pick-up or drop-off points are arranged and priced separately at booking."
          }
        },
        {
          "@type": "Question",
          "name": "Are child seats available?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, on request when you book. Let us know the child's age and weight so we can fit the correct seat."
          }
        },
        {
          "@type": "Question",
          "name": "What about night or very early morning transfers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We drive 24/7. Departures before 07:00 or after 22:00 are charged at the night rate, which the calculator applies automatically."
          }
        },
        {
          "@type": "Question",
          "name": "Can we travel with a pet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, with advance notice so we can prepare the vehicle."
          }
        },
        {
          "@type": "Question",
          "name": "Is there Wi-Fi and charging in the car?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — Wi-Fi and USB charging are available on board."
          }
        },
        {
          "@type": "Question",
          "name": "Is a private operator as safe as a large company?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We are a licensed carrier with fully prepared and insured vehicles and professional drivers who know these routes and have driven them many times."
          }
        }
      ]
    }
